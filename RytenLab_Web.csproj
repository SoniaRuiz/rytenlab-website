<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<!--<TargetFramework>net8.0</TargetFramework>-->
	</PropertyGroup>

	<ItemGroup>
	<Compile Remove="wwwroot\team_cv\**" />
	<Content Remove="wwwroot\team_cv\**" />
	<EmbeddedResource Remove="wwwroot\team_cv\**" />
	<None Remove="wwwroot\team_cv\**" />
	</ItemGroup>

	<ItemGroup>
	<Content Remove="wwwroot\css\album.css" />
	<Content Remove="wwwroot\css\font-awesome.min.css" />
	<Content Remove="wwwroot\css\main.css" />
	</ItemGroup>

	<ItemGroup>
	<Content Include="App_Data\**" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Microsoft.Build" Version="18.11.0" />
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
		<PackageReference Include="NuGet.Packaging" Version="7.9.0" />
		<PackageReference Include="NuGet.Protocol" Version="7.9.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

	<PropertyGroup>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>
	<StartupObject>RytenLab_Web.Program</StartupObject>
	</PropertyGroup>

</Project>
