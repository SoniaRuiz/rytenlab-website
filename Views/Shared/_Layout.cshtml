<!DOCTYPE html>
<html>
<head profile="http://gmpg.org/xfn/11">
    <link rel="shortcut icon" type="image/x-icon" href="~/images/ucl-icon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RytenLab</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <environment exclude="Development">

        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />

        @if (Context.Features.Get<Microsoft.AspNetCore.Http.Features.ITrackingConsentFeature>()?.CanTrack ?? false)
        {
            <!-- GOOGLE ANALYTICS (only loaded after the visitor accepts cookies) -->
            <script async src="https://www.googletagmanager.com/gtag/js?id=G-PD5SEMENW0"></script>
            <script>
                        window.dataLayer = window.dataLayer || [];
                        function gtag() { dataLayer.push(arguments); }
                        gtag('js', new Date());

                        gtag('config', 'G-PD5SEMENW0');
            </script>
        }

    </environment>
</head>
<body>
    <nav class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                @* Required to show collapsed menu from mobile access *@
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#rytenlab_menu">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button> 
                <a asp-area="" asp-controller="RytenLab" asp-action="About" class="navbar-brand" style="font-size:24px !important;">Ryten Lab</a>
            </div>

            <div class="navbar-collapse collapse" id="rytenlab_menu">

                <ul class="nav navbar-nav">

                    <li id="tab_about"><a asp-area="" asp-controller="RytenLab" asp-action="About">About us</a></li>
                    
                    @*<li><a asp-area="" asp-controller="RytenLab" asp-action="Data">Data</a></li>*@
                    
                    @* <li><a asp-area="" asp-controller="RytenLab" asp-action="#">Funding</a></li> *@

                    <li id="tab_science" class="nav-item dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="true"> 
                            <span class="nav-label">Science</span> <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu">
                            <li id="tab_research"><a asp-area="" asp-controller="RytenLab" asp-action="Research">Research</a></li>
                            <li id="tab_publications"><a asp-area="" asp-controller="RytenLab" asp-action="Publications">Publications</a></li>
                            <li id="tab_tools"><a asp-area="" asp-controller="RytenLab" asp-action="Tools">Tools</a></li>
                        </ul>
                    </li>

                    <li id="tab_team" class="nav-item dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="true"> 
                            <span class="nav-label">Team</span> <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu">
                            <li id="tab_current_members"><a asp-area="" asp-controller="RytenLab" asp-action="Team">Current Members</a></li>
                            <li id="tab_alumni"><a asp-area="" asp-controller="RytenLab" asp-action="FormerMembers">Former Members</a></li>
                            <li id="tab_furry_members"><a asp-area="" asp-controller="RytenLab" asp-action="FurryMembers">Furry Members</a></li>
                        </ul>
                    </li>


                    
                    
                    <li id="tab_contact"><a asp-area="" asp-controller="RytenLab" asp-action="Contact">Contact us</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <partial name="_CookieConsentPartial" />

    <div class="container body-content">
        @RenderBody()
        <hr />
    </div>
    <footer>
        <div id="footer_text" class="text-right">
            <small>&copy; 2025 - RytenLab</small>

         @*    <span id="siteseal">
                <script async type="text/javascript" src="https://seal.godaddy.com/getSeal?sealID=fi4LZ7KfKJo57dque6gyQdEgdBKpwzuR1XOaKPrk4PuTdyfiITsIioOF8Vgz"></script>
            </span> *@
        </div>
    </footer>

    <script src="~/lib/font-awesome/js/all.js"></script>
    <script src="~/lib/jquery/dist/jquery-3.7.1.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js" asp-append-version="true"></script>
    <environment include="Development">
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/site.min.js" asp-append-version="true"></script>
    </environment>

    @RenderSection("Scripts", required: false)

</body>
</html>
